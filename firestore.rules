rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica se o usuário autenticado é o criador da viagem informada
    // (usado para permitir que o criador limpe dados da viagem ao excluí-la)
    function isTripCreator(appId, tripId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/trips/$(tripId)).data.creator == request.auth.uid;
    }

    function tripData(appId, tripId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/trips/$(tripId)).data;
    }

    // Viagem finalizada bloqueia lançamentos de despesas e atividades
    function isTripOpen(appId, tripId) {
      return tripData(appId, tripId).get('status', 'open') != 'finished';
    }

    function isTripMember(appId, tripId, uid) {
      return uid in tripData(appId, tripId).members;
    }

    // ──────────────────────────────────────────────
    // Raiz dos artefatos: artifacts/{appId}/...
    // ──────────────────────────────────────────────
    match /artifacts/{appId} {

      // Perfil do usuário — leitura aberta a autenticados (necessário para
      // exibir nome/e-mail dos membros da viagem) | escrita: somente o dono
      match /users/{userId}/profile/data {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Índice público de e-mails para busca de convites
      // Leitura: qualquer autenticado | Escrita: somente o próprio usuário
      match /public/data/emails/{email} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
      }

      // Viagens (trips) — leitura aberta a autenticados; criação pelo dono
      match /public/data/trips/{tripId} {
        allow read: if request.auth != null;

        // Criação: o autor deve incluir a si mesmo como membro
        allow create: if request.auth != null
          && request.resource.data.creator == request.auth.uid
          && request.auth.uid in request.resource.data.members;

        // Atualização: membros da viagem podem alterar livremente;
        // um não-membro só pode se auto-adicionar (aceitar convite),
        // alterando exclusivamente o campo members e somando 1 participante
        // Status de finalização (status/finishedAt/finishedBy/finalSummary) só pelo criador;
        // viagem finalizada não aceita novos membros
        allow update: if request.auth != null
          && (
            (
              request.auth.uid in resource.data.members
              && (
                resource.data.creator == request.auth.uid
                || !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['status', 'finishedAt', 'finishedBy', 'finalSummary', 'creator'])
              )
            )
            || (
              request.auth.uid in request.resource.data.members
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
              && request.resource.data.members.size() == resource.data.members.size() + 1
              && resource.data.get('status', 'open') != 'finished'
            )
          );

        // Apenas o criador pode apagar a viagem
        allow delete: if request.auth != null
          && resource.data.creator == request.auth.uid;
      }

      // Convites — leitura aberta a autenticados
      match /public/data/invites/{inviteId} {
        allow read: if request.auth != null;

        // Apenas o remetente pode criar o convite
        allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid;

        // O destinatário pode atualizar o status (aceitar/recusar)
        allow update: if request.auth != null
          && resource.data.toUid == request.auth.uid;

        // O remetente ou o criador da viagem podem apagar o convite
        allow delete: if request.auth != null
          && (
            resource.data.fromUid == request.auth.uid
            || isTripCreator(appId, resource.data.tripId)
          );
      }

      // Notificações — um documento por destinatário.
      // Criação: membro da viagem notificando outro membro da mesma viagem.
      // Leitura/edição/exclusão: somente o destinatário (edição só do campo read).
      match /public/data/notifications/{notificationId} {
        allow read: if request.auth != null
          && resource.data.toUid == request.auth.uid;

        allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.read == false
          && isTripMember(appId, request.resource.data.tripId, request.auth.uid)
          && isTripMember(appId, request.resource.data.tripId, request.resource.data.toUid);

        allow update: if request.auth != null
          && resource.data.toUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        allow delete: if request.auth != null
          && resource.data.toUid == request.auth.uid;
      }

      // Despesas por viagem — leitura por membros autenticados;
      // criação/edição/exclusão somente pelo autor do lançamento
      match /public/data/{expenseCol}/{expenseId} {
        allow read: if request.auth != null
          && expenseCol.matches('expenses_.*');

        allow create: if request.auth != null
          && expenseCol.matches('expenses_.*')
          && request.resource.data.uid == request.auth.uid
          && isTripOpen(appId, expenseCol.split('_')[1]);

        allow update: if request.auth != null
          && expenseCol.matches('expenses_.*')
          && resource.data.uid == request.auth.uid
          && isTripOpen(appId, expenseCol.split('_')[1]);

        // Exclusão: o autor do lançamento ou o criador da viagem
        // (necessário para o criador poder apagar a viagem inteira)
        allow delete: if request.auth != null
          && expenseCol.matches('expenses_.*')
          && (
            (resource.data.uid == request.auth.uid && isTripOpen(appId, expenseCol.split('_')[1]))
            || isTripCreator(appId, expenseCol.split('_')[1])
          );
      }

      // Dicas e cronograma por viagem
      match /public/data/{tipsCol}/{tipId} {
        allow read: if request.auth != null
          && tipsCol.matches('tips_.*');

        // Qualquer autenticado pode criar uma dica
        allow create: if request.auth != null
          && tipsCol.matches('tips_.*')
          && request.resource.data.createdBy == request.auth.uid
          && isTripOpen(appId, tipsCol.split('_')[1]);

        // Qualquer autenticado pode votar (só campos de voto/status);
        // edição do conteúdo é restrita ao autor da dica
        allow update: if request.auth != null
          && tipsCol.matches('tips_.*')
          && isTripOpen(appId, tipsCol.split('_')[1])
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesUp', 'votesDown', 'status'])
            || resource.data.createdBy == request.auth.uid
          );

        // Exclusão: o autor da dica ou o criador da viagem
        // (necessário para o criador poder apagar a viagem inteira)
        allow delete: if request.auth != null
          && tipsCol.matches('tips_.*')
          && (
            (resource.data.createdBy == request.auth.uid && isTripOpen(appId, tipsCol.split('_')[1]))
            || isTripCreator(appId, tipsCol.split('_')[1])
          );
      }
    }
  }
}
